# 메일 계정 설정 (IMAP)
MAIL_HOST=imap.gmail.com
MAIL_PORT=993
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# 정산 메일 발신자 (배민) — 실제: noreply@woowahan.com
BAEMIN_MAIL_SENDER=woowahan.com

# 토더(ToOrder) 본사 로그인 자격증명 (--fetch 자동수집용)
TOORDER_ID=
TOORDER_PW=

# 다운로드 폴더
DOWNLOAD_DIR=downloads

# 출력 폴더
OUTPUT_DIR=output

# 로그 폴더
LOG_DIR=logs

# 점포 마스터 파일 경로
MASTER_FILE=점포마스터.xlsx

# 정산 대상 기간 (비워두면 실행 시 입력)
# 형식: YYYY-MM (예: 2026-05)
TARGET_MONTH=
